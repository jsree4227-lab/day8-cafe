{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cafe",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),path=require('path');const T={'.html':'text/html; charset=utf-8','.js':'text/javascript','.css':'text/css','.json':'application/json'};http.createServer((q,s)=>{let p=decodeURIComponent(q.url.split('?')[0]);if(p==='/')p='/index.html';const f=path.join(process.cwd(),path.normalize(p));if(!f.startsWith(process.cwd())){s.writeHead(403);return s.end();}fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);return s.end('Not found');}s.writeHead(200,{'Content-Type':T[path.extname(f)]||'application/octet-stream'});s.end(d);});}).listen(5500)"
      ],
      "port": 5500
    }
  ]
}
